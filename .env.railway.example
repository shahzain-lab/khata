# =============================================================================
# Khata on Railway — copy values into each service's Variables tab
# =============================================================================

# ---- Shared (set on both api + web where noted) ----
DEMO=false
NODE_ENV=production

# ---- Postgres (Railway Postgres plugin — usually auto-injected when linked) ----
# Prefer linking the Postgres service; Railway provides DATABASE_URL.
# DB_TYPE=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Or discrete vars:
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASS=${{Postgres.PGPASSWORD}}
DB_SSL_MODE=true
DB_SYNCHRONIZE=false
DB_ORM=typeorm

# ---- API service only ----
# API_HOST / API_PORT are set by entrypoint from Railway PORT — do not hardcode PORT.
API_BASE_URL=https://YOUR-API.up.railway.app
CLIENT_BASE_URL=https://YOUR-WEB.up.railway.app
ALLOWED_ORIGINS=https://YOUR-WEB.up.railway.app

# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_VERIFICATION_TOKEN_SECRET=
EXPRESS_SESSION_SECRET=

# Optional
# ENCRYPTION_KEY=

# ---- Web (UI) service only ----
API_BASE_URL=https://YOUR-API.up.railway.app
CLIENT_BASE_URL=https://YOUR-WEB.up.railway.app
API_HOST=YOUR-API.up.railway.app
API_PORT=443
DEMO=false
COMPANY_SITE_NAME=Khata
COMPANY_NAME=Khata
PLATFORM_WEBSITE_URL=https://YOUR-WEB.up.railway.app
