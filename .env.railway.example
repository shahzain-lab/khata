# =============================================================================
# Khata on Railway — copy values into each service's Variables tab
# =============================================================================
# CRITICAL:
# - Do NOT set PORT on either service (Railway injects it).
# - Do NOT set API_HOST on the API service (must bind 0.0.0.0; entrypoint enforces that).
# - API JWT/session secrets MUST be non-empty or the API crash-loops and fails healthchecks.
# - Web: API_HOST is the public API hostname (no https://) for the UI bundle only.
# =============================================================================

# ---- Shared ----
DEMO=false
NODE_ENV=production

# ---- API service ----
# Link Postgres so Railway provides DATABASE_URL, or set:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_TYPE=postgres
DB_SSL_MODE=true
DB_SYNCHRONIZE=false
DB_ORM=typeorm

API_BASE_URL=https://YOUR-API.up.railway.app
CLIENT_BASE_URL=https://YOUR-WEB.up.railway.app
ALLOWED_ORIGINS=https://YOUR-WEB.up.railway.app

# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_ME_openssl_rand_hex_64
JWT_REFRESH_TOKEN_SECRET=REPLACE_ME_openssl_rand_hex_64
JWT_VERIFICATION_TOKEN_SECRET=REPLACE_ME_openssl_rand_hex_64
EXPRESS_SESSION_SECRET=REPLACE_ME_openssl_rand_hex_64

# ---- Web (UI) service only ----
API_BASE_URL=https://YOUR-API.up.railway.app
CLIENT_BASE_URL=https://YOUR-WEB.up.railway.app
# Hostname only (no scheme) — used inside the Angular bundle, not for listen bind
API_HOST=YOUR-API.up.railway.app
API_PORT=443
DEMO=false
COMPANY_SITE_NAME=Khata
COMPANY_NAME=Khata
PLATFORM_WEBSITE_URL=https://YOUR-WEB.up.railway.app
